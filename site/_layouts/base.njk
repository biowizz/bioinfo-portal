<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Bioinformatics Conferences & Jobs" }}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧬</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="{{ '/' | url }}"><span class="brand-mark">🧬</span> Bioinfo Portal</a>
      <nav>
        <a href="{{ '/' | url }}" class="{{ 'is-active' if page.url == '/' }}">All</a>
        <a href="{{ '/conferences/' | url }}" class="{{ 'is-active' if page.url == '/conferences/' }}">Conferences</a>
        <a href="{{ '/jobs/' | url }}" class="{{ 'is-active' if page.url == '/jobs/' }}">Jobs</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>Bioinformatics conferences and jobs, curated. No ads.</p>
    </div>
  </footer>

  <script src="{{ '/app.js' | url }}"></script>
</body>
</html>
